rules_version = '2';

// =========================================================
// セカンドハウス管理アプリ  セキュリティルール
// Firebase コンソール → Firestore Database →「ルール」タブに、
// このファイルの中身を全部貼り付けて「公開」してください。
//
// 共有アカウント（合言葉）でログインした人だけが読み書きできます。
// メールアドレスは js/config.js の SHARED_EMAIL と同じにしてください。
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isHouse() {
      return request.auth != null
        && request.auth.token.email == 'house@example.com';
    }

    match /{document=**} {
      allow read, write: if isHouse();
    }
  }
}
